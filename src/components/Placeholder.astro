---
/** A labeled stand-in for a photo or screenshot that hasn't been added yet. */
interface Props {
  label: string;
  ratio?: string; // CSS aspect-ratio, e.g. "4 / 3"
  class?: string;
}
const { label, ratio = '4 / 3', class: className = '' } = Astro.props;
---

<div class:list={['ph', className]} style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Placeholder: ${label}`}>
  <span class="ph__label">{label}</span>
</div>

<style>
  .ph {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    background: var(--tint);
  }
  .ph__label {
    font-size: 0.75rem;
    line-height: 1.4;
    text-align: center;
    color: var(--mist);
    padding: 0.35rem 0.75rem;
    max-width: 88%;
    background: var(--white);
    border-radius: 999px;
  }
</style>
