---
/**
 * Pixel-art mallard, drawn on a 28×28 grid and rendered at 2× (a 56×56 grid) so the eye can use
 * half-size pixels: a big white eye with a pupil that follows the cursor (src/scripts/duck.ts).
 *  - variant "full": head, collar and chest (hero, 404)
 *  - variant "head": just the head (nav)
 */
interface Props {
  variant?: 'full' | 'head';
  class?: string;
  label?: string;
  interactive?: boolean;
}
const { variant = 'full', class: className = '', label = '', interactive = false } = Astro.props;

const C: Record<string, string> = {
  o: '#0f0718', // outline
  g: '#1d643f', // head green
  d: '#0d4140', // head shadow
  s: '#3d954e', // sheen
  h: '#53a263', // sheen highlight
  l: '#78b08b', // brightest sheen
  y: '#facd50', // bill highlight
  b: '#f0ae12', // bill
  n: '#c27117', // bill shadow
  c: '#a4b2b8', // collar shadow
  w: '#fefefd', // collar
  r: '#7a2b16', // chest
  m: '#4b1523', // chest shadow
};
const WHITE = '#ffffff';

// One character per pixel; '.' is transparent.
const ART = [
  '...............ooooooo......',
  '.............oosgggggdoo....',
  '...........oosgghhhhsggdo...',
  '..........ogsggggggghhggdo..',
  '.........ogsgggggggggghggdo.',
  '.........osggggdddgggggggdo.',
  '........odggggdgggdggggggddo',
  '........oggggddgggdgggggggdo',
  '........odogdddggggslgggggdo',
  '.......oyoyoddggggssgsggggdo',
  '......oyyybodgggggggggggggdo',
  '....ooyyobbodgggggggggggdgdo',
  '..ooyybbbbbnogggggggggggdgdo',
  '.oyybbbbbbbbnogggggggggddgdo',
  'obbbbbbbbnnonodgggggggdddgdo',
  'oonnnnnnooonoddddgggddodgddo',
  '..oooooo...oooddddddooddgddo',
  '..............oooooodddggdo.',
  '..............odddddddgggdo.',
  '..............odddddggggddo.',
  '..............odggggggggddo.',
  '.............odggggggggdcco.',
  '.............ocwgggggwwwcmmo',
  '............omrwwwwwwwcmmmmo',
  '...........omrrrrrrrrmmmmmm.',
  '...........omrrrrrrrrrmmm...',
  '............mrrrrrrrrmm.....',
  '..............rrrrrrr.......',
];
const S = 2; // render scale: one art pixel = 2×2 grid pixels
const W = ART[0].length * S;
const H = ART.length * S;

// Art pixels as horizontal runs, scaled up.
const rects: { x: number; y: number; w: number; h: number; fill: string }[] = [];
ART.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const ch = row[x];
    if (ch === '.') { x++; continue; }
    let w = 1;
    while (x + w < row.length && row[x + w] === ch) w++;
    rects.push({ x: x * S, y: y * S, w: w * S, h: S, fill: C[ch] });
    x += w;
  }
});

// The eye, on the fine grid: an oval white with a one-pixel outline.
const EYE = { cx: 33, cy: 15, rx: 5, ry: 4.6 };
const inEye = (x: number, y: number) => ((x + 0.5 - EYE.cx) / EYE.rx) ** 2 + ((y + 0.5 - EYE.cy) / EYE.ry) ** 2 <= 1;
const eye: { x: number; y: number; w: number; fill: string }[] = [];
const lids: { x: number; y: number; w: number }[] = [];
for (let y = EYE.cy - 7; y <= EYE.cy + 7; y++) {
  for (let x = EYE.cx - 8; x <= EYE.cx + 8; x++) {
    const white = inEye(x, y);
    const rim = !white && [[1, 0], [-1, 0], [0, 1], [0, -1]].some(([dx, dy]) => inEye(x + dx, y + dy));
    if (white) { eye.push({ x, y, w: 1, fill: WHITE }); lids.push({ x, y, w: 1 }); }
    else if (rim) eye.push({ x, y, w: 1, fill: C.o });
  }
}
// Pupil: 4×4 with the corners cut, plus a glint. duck.ts moves it up to 3 fine pixels.
const PUPIL = { x: EYE.cx - 2, y: EYE.cy - 2 };

const viewBox = variant === 'full' ? `0 0 ${W} ${H}` : `0 0 ${W} 34`;
const a11y = interactive
  ? { role: 'button', tabindex: 0, 'aria-label': `${label || 'Pixel-art duck'}. Press to quack.` }
  : label
    ? { role: 'img', 'aria-label': label }
    : { 'aria-hidden': 'true' };
---

<div class:list={['duck', `duck--${variant}`, interactive && 'duck--interactive', className]} data-duck {...a11y}>
  <svg viewBox={viewBox} shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.fill} />)}
    <g data-eye>{eye.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}</g>
    <g class="duck__pupils" data-pupils>
      <g transform={`translate(${PUPIL.x} ${PUPIL.y})`}>
        <rect x="1" y="0" width="2" height="1" fill={C.o} />
        <rect x="0" y="1" width="4" height="2" fill={C.o} />
        <rect x="1" y="3" width="2" height="1" fill={C.o} />
        <rect x="1" y="1" width="1" height="1" fill={WHITE} />
      </g>
    </g>
    <g class="duck__lids">
      {lids.map((l) => <rect x={l.x} y={l.y} width={l.w} height="1" fill={C.g} />)}
    </g>
  </svg>
  {interactive && <span class="duck__bubble" aria-live="polite" data-bubble></span>}
</div>

<style>
  .duck { position: relative; display: block; line-height: 0; }
  .duck svg { width: 100%; height: auto; display: block; }
  .duck__pupils { transition: transform 70ms linear; }
  .duck__lids { opacity: 0; }
  .duck.is-blinking .duck__lids { opacity: 1; }

  .duck--interactive { cursor: pointer; user-select: none; -webkit-tap-highlight-color: transparent; }
  .duck--interactive:focus-visible { outline: 2px solid var(--blaze); outline-offset: 6px; }
  .duck--interactive.is-quacking svg { animation: duck-bob 360ms steps(3, end); }

  .duck__bubble {
    position: absolute;
    left: 70%;
    bottom: 92%;
    font-family: 'Silkscreen', monospace;
    font-size: 0.95rem;
    line-height: 1;
    color: #1a1a1a;
    background: #fff;
    border: 2px solid #1a1a1a;
    padding: 0.45em 0.65em;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    white-space: nowrap;
  }
  .duck__bubble.is-on { opacity: 1; transform: none; transition: transform 160ms steps(2, end); }

  @keyframes duck-bob {
    0%, 100% { transform: none; }
    50% { transform: translateY(-6%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .duck--interactive.is-quacking svg { animation: none; }
    .duck__pupils { transition: none; }
  }
</style>
