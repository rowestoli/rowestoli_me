---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PixelDuck from '../components/PixelDuck.astro';
import Placeholder from '../components/Placeholder.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, experience } from '../data/site';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
import Photo from '../components/Photo.astro';
import { photo } from '../data/photos';
---

<Base>
  <section class="wrap hero">
    <div class="hero__copy">
      <h1 class="hero__name" aria-label="Rowe Stodolnic">
        <span class="line" aria-hidden="true"><span>Rowe</span></span>
        <span class="line" aria-hidden="true"><span>Stodolnic</span></span>
      </h1>
      <p class="lede rise" style="--d: 350ms">
        I work where product, program management and engineering meet. I built QuackLog, an iOS app for duck hunters,
        from the first sketch to the App Store.
      </p>
      <div class="hero__actions rise" style="--d: 450ms">
        <a class="btn" href="/work">See my work</a>
        <a class="btn btn--ghost" href={site.github} target="_blank" rel="noopener">
          <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.82 1.19 3.08 0 4.41-2.69 5.39-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          GitHub
        </a>
        <a class="btn btn--ghost" href={site.linkedin} target="_blank" rel="noopener">
          <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
          LinkedIn
        </a>
      </div>
      <p class="hero__meta muted rise" style="--d: 550ms">Brown University, Class of 2027. Computer Science and Business Economics. San Francisco Bay Area.</p>
    </div>
    <div class="hero__tile">
      <PixelDuck interactive label="Pixel-art mallard. Its eyes follow your cursor" class="hero__duck" />
    </div>
  </section>

  <section class="section wrap" aria-labelledby="selected">
    <div class="section__head">
      <h2 id="selected">Selected work</h2>
      <p class="muted">Two apps, an AI system I'm building, and a Go engine you can play.</p>
    </div>
    <ul class="grid">
      {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
    </ul>
    <p class="more"><a href="/work">See all {all.length} projects</a></p>
  </section>

  <section class="section wrap about" aria-labelledby="about">
    <div class="about__photo">
      <Photo src={photo('headshot', 'headshot')} alt="Rowe Stodolnic" label="Headshot here" ratio="4 / 5" position="50% 30%" sizes="(max-width: 860px) 300px, 32vw" />
    </div>
    <div class="about__copy">
      <h2 id="about">About me</h2>
      <!-- Draft copy: edit to taste -->
      <p class="lede">
        I'm a senior at Brown studying Computer Science and Business Economics. I like the whole arc of a product:
        finding out what people actually need, deciding what to build first, and then building it.
      </p>
      <p>
        This past year I worked on security programs at Okta, built reporting and tooling at Kindred Motorworks, and
        shipped my first app on my own. I'm looking for product and program management roles where I can stay close to
        the engineering.
      </p>
      <p>
        Off the screen, I play flanker for Brown's First XV and photograph cars.{' '}
        <a href="/personal">More about life outside work</a>.
      </p>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="experience">
    <div class="section__head">
      <h2 id="experience">Experience</h2>
    </div>
    <ol class="timeline">
      {experience.map((job) => (
        <li class="job">
          <div class="job__when muted">{job.when}</div>
          <div class="job__body">
            <h3>{job.role}, <span class="job__co">{job.company}</span></h3>
            <p class="muted job__place">{job.place}</p>
            <ul>{job.points.map((pt) => <li>{pt}</li>)}</ul>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap contact" id="contact" aria-labelledby="contact-h">
    <h2 id="contact-h">Get in touch</h2>
    <p class="lede">I'm looking for full-time product and program management roles starting after May 2027. The fastest way to reach me is email.</p>
    <div class="hero__actions">
      <a class="btn" href={`mailto:${site.email}`}>Email me</a>
      <a class="btn btn--ghost" href={site.linkedin}>LinkedIn</a>
      <a class="btn btn--ghost" href={site.github}>GitHub</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    align-items: center; gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3.5rem, 10vw, 7rem);
  }
  .hero__copy { display: grid; gap: 1.4rem; justify-items: start; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero__meta { font-size: var(--step--1); max-width: 34rem; }

  /* Name slides up line by line from behind a mask */
  .line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .line > span { display: inline-block; animation: line-up 900ms var(--ease-out) both; }
  .line:nth-child(2) > span { animation-delay: 110ms; }
  @keyframes line-up { from { transform: translateY(105%); } to { transform: none; } }

  /* The duck pops up into its tile, then its eyes follow the cursor */
  .hero__tile {
    position: relative; justify-self: end;
    width: min(100%, 320px); aspect-ratio: 1;
    border-radius: 28px; background: #dfeae4;
    animation: tile-in 700ms 200ms var(--ease-out) both;
  }
  .hero__tile :global(.hero__duck) {
    position: absolute; left: 11%; right: 11%; bottom: 0;
    animation: duck-up 800ms 550ms var(--ease-out) both;
  }
  @keyframes tile-in { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: none; } }
  @keyframes duck-up { from { transform: translateY(40%); opacity: 0; } to { transform: none; opacity: 1; } }

  .grid {
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-flow: dense;
    gap: clamp(2rem, 4vw, 3rem) clamp(1rem, 2.5vw, 2rem);
    margin: 0; padding: 0;
  }
  .more { margin-top: 2.5rem; font-weight: 700; }

  .about { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .about__copy { display: grid; gap: 1.1rem; max-width: 38rem; }

  .timeline { list-style: none; margin: 0; padding: 0; max-width: 52rem; }
  .job { position: relative; display: grid; grid-template-columns: 9rem 1fr; gap: 1.5rem; padding: 0 0 2.25rem; }
  .job__when { font-size: var(--step--1); padding-top: 0.2rem; }
  .job__body { position: relative; padding-left: 1.75rem; border-left: 1.5px solid var(--line); view-timeline-name: --job; }
  .job__body::before {
    content: ''; position: absolute; z-index: 1; left: -7.5px; top: 0.45rem;
    width: 13px; height: 13px; border-radius: 50%;
    background: var(--fern); border: 2px solid var(--fern); box-shadow: 0 0 0 4px var(--paper);
  }
  /* A green line that fills in as each role scrolls into view */
  .job__body::after {
    content: ''; position: absolute; left: -1.5px; top: 0; bottom: -2.25rem; width: 1.5px;
    background: var(--fern); transform-origin: top;
  }
  .job:last-child .job__body::after { bottom: 0; }
  @supports (animation-timeline: view()) {
    .job__body::after { animation: draw linear both; animation-timeline: --job; animation-range: entry 30% cover 60%; }
    .job__body::before { animation: dot linear both; animation-timeline: --job; animation-range: entry 30% entry 70%; }
  }
  @keyframes draw { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes dot { from { background: var(--white); transform: scale(0.7); } to { background: var(--fern); transform: scale(1); } }
  .job__co { color: var(--forest); }
  .job__place { font-size: var(--step--1); margin-top: 0.15rem; }
  .job ul { margin: 0.75rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.4rem; color: var(--ink-2); font-size: 0.9375rem; }

  .contact { display: grid; gap: 1.4rem; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding-top: 2.5rem; }
    .hero__tile { justify-self: start; width: min(60%, 240px); grid-row: 1; }
    .about { grid-template-columns: 1fr; }
    .about__photo { max-width: 300px; }
  }
  @media (max-width: 560px) {
    .job { grid-template-columns: 1fr; gap: 0.4rem; }
  }
</style>
