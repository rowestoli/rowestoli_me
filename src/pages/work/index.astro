---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { categoryLabels } from '../../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const plural: Record<string, string> = { app: 'Apps', ai: 'AI', web: 'Web & data', design: 'Design' };
const filters = [
  { id: 'all', label: 'All' },
  ...Object.keys(categoryLabels).map((id) => ({ id, label: plural[id] })),
];
const count = (id: string) => (id === 'all' ? projects.length : projects.filter((p) => p.data.category === id).length);
---

<Base title="Work" description="Apps, AI systems, web projects and design work by Rowe Stodolnic.">
  <section class="wrap work">
    <header class="work__head">
      <h1>Work</h1>
      <p class="lede">Apps I've shipped, AI systems I'm building, and interactive projects you can try right in the browser.</p>
    </header>

    <div class="filters" role="group" aria-label="Filter projects">
      {filters.map((f, i) => (
        <button class="chip" type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label} <span class="chip__n">{count(f.id)}</span>
        </button>
      ))}
    </div>

    <ul class="grid" data-list>
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </ul>
    <p class="empty muted" data-empty hidden>Nothing here yet. Pick another filter.</p>
  </section>
</Base>

<style>
  .work { padding-block: clamp(3rem, 8vw, 5rem) clamp(4rem, 10vw, 7rem); }
  .work__head { display: grid; gap: 1rem; margin-bottom: 2.25rem; }

  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2.25rem; }
  .chip {
    font: inherit; font-size: var(--step--1); font-weight: 700;
    color: var(--ink-2); background: var(--white);
    border: 1.5px solid var(--line); border-radius: 999px;
    padding: 0.45rem 0.95rem; cursor: pointer;
    transition: background 160ms, color 160ms, border-color 160ms;
  }
  .chip:hover { border-color: var(--fern); color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
  .chip__n { opacity: 0.55; margin-left: 0.15rem; }

  .grid {
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-flow: dense;
    gap: clamp(2rem, 4vw, 3rem) clamp(1rem, 2.5vw, 2rem);
    margin: 0; padding: 0;
  }
</style>
