---
import Base from '../layouts/Base.astro';
import PixelDuck from '../components/PixelDuck.astro';
---

<Base title="Page not found">
  <section class="wrap lost">
    <div class="lost__duck"><PixelDuck interactive label="A pixel-art duck looking for the page" /></div>
    <h1>This page flew south.</h1>
    <p class="lede">The link may be old or mistyped.</p>
    <div><a class="btn" href="/">Go to the home page</a></div>
  </section>
</Base>

<style>
  .lost { display: grid; gap: 1.5rem; justify-items: start; padding-block: clamp(3rem, 10vw, 6rem); }
  .lost__duck { width: min(180px, 50vw); }
  .lost h1 { font-size: clamp(2.2rem, 6vw, 4rem); }
</style>
