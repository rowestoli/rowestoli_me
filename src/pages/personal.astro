---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import Photo from '../components/Photo.astro';
import { getImage } from 'astro:assets';
import { carAlt, photo, photos } from '../data/photos';

const honors = [
  { year: '2024', text: 'NCR Division I National Champions' },
  { year: '2023 – 25', text: 'Ivy League and Liberty Conference Champions' },
  { year: '2023 – 25', text: 'NCR Academic All-American' },
  { year: '2023 – 25', text: 'Liberty Conference All-Star nominee' },
  { year: '2025', text: 'All Conference' },
];

// Rugby: the wide slot uses an action shot if there is one, otherwise the team photo.
const action = photo('rugby', 'action-wide');
const team = photo('rugby', 'team');
const wide = action ?? team;
const wideAlt = action ? 'Rowe playing rugby for Brown' : 'Brown Rugby celebrating the 2024 NCR Division I national championship';

// Car photography: every photo in src/assets/img/cars, in file-name order, with a larger version for the lightbox.
const cars = await Promise.all(photos('cars').map(async (p) => ({
  ...p,
  alt: carAlt[p.name] ?? 'Car photo',
  full: (await getImage({ src: p.src, width: Math.min(2000, p.src.width), format: 'webp' })).src,
})));
const carSlots = [
  { label: 'Car photo 1 here (landscape)', ratio: '3 / 2' },
  { label: 'Car photo 2 here (portrait)', ratio: '4 / 5' },
  { label: 'Car photo 3 here (landscape)', ratio: '3 / 2' },
];

// Empty slots show as labeled placeholders in `npm run dev` only. The live site hides
// them until there's a photo (or, for hobbies, real text) to show.
const SHOW_SLOTS = import.meta.env.DEV;

const allHobbies = [
  { title: 'Building my PC', text: 'A custom build that now runs local AI models for my side projects.', label: 'PC build photo here', src: photo('hobbies', 'pc-build') },
  { title: 'Hobby title here', text: 'Placeholder: something you love doing and why.', label: 'Hobby photo here', src: photo('hobbies', 'hobby-2'), draft: true },
  { title: 'Hobby title here', text: 'Placeholder: another thing worth knowing about you.', label: 'Hobby photo here', src: photo('hobbies', 'hobby-3'), draft: true },
];
const hobbies = allHobbies.filter((h) => SHOW_SLOTS || !h.draft);

const strip = [
  { src: photo('rugby', 'rugby-1'), alt: 'Brown Rugby match', label: 'Rugby photo here' },
  { src: action ? team : undefined, alt: 'Brown Rugby team photo', label: 'Team photo here' },
  { src: photo('rugby', 'rugby-2'), alt: 'Brown Rugby match', label: 'Rugby photo here' },
].filter((p) => SHOW_SLOTS || p.src);
---

<Base title="Personal" description="Rugby, car photography and life outside work.">
  <section class="wrap intro">
    <h1>Off the clock</h1>
    <p class="lede">Rugby taught me most of what I know about teams. The rest of my free time goes to cameras, cars and building things.</p>
  </section>

  <section class="section wrap rugby" aria-labelledby="rugby">
    <div class="rugby__photo">
      <Photo src={wide} alt={wideAlt} label="Rugby action shot here (wide)" ratio="16 / 10" sizes="(max-width: 860px) 100vw, 56vw" eager />
    </div>
    <div class="rugby__copy">
      <h2 id="rugby">Brown Rugby</h2>
      <p>I play flanker for the Brown Men's Rugby First XV. Off the field I've served as recruitment chair and now social chair.</p>
      <ul class="honors">
        {honors.map((h) => (
          <li><span class="muted">{h.year}</span><span>{h.text}</span></li>
        ))}
      </ul>
    </div>
    {strip.length > 0 && (
      <div class="rugby__strip">
        {strip.map((p) => (
          <Photo src={p.src} alt={p.alt} label={p.label} ratio="1 / 1" sizes="(max-width: 860px) 33vw, 22rem" />
        ))}
      </div>
    )}
  </section>

  <section class="section wrap" aria-labelledby="cars">
    <div class="section__head">
      <h2 id="cars">Car photography</h2>
      <p class="muted">Select a photo to see it larger.</p>
    </div>
    <div class="gallery">
      {cars.length
        ? cars.map((c) => (
            <button class="gallery__item" type="button" data-lightbox data-full={c.full} data-alt={c.alt} aria-label={`Open photo: ${c.alt}`}>
              <Photo src={c.src} alt={c.alt} label="" ratio={`${c.src.width} / ${c.src.height}`} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 24rem" />
            </button>
          ))
        : carSlots.map((c) => (
            <button class="gallery__item" type="button" data-lightbox aria-label={`Open ${c.label}`}>
              <Placeholder label={c.label} ratio={c.ratio} />
            </button>
          ))}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="else">
    <div class="section__head">
      <h2 id="else">Other things I'm into</h2>
    </div>
    <div class="hobbies">
      {hobbies.map((h) => (
        <article class="hobby">
          {(h.src || SHOW_SLOTS) && <Photo src={h.src} alt={h.title} label={h.label} ratio="4 / 3" sizes="(max-width: 860px) 100vw, 30vw" />}
          <h3>{h.title}</h3>
          <p class="muted">{h.text}</p>
        </article>
      ))}
    </div>
  </section>

  <dialog class="lightbox" data-lightbox-dialog aria-label="Photo viewer">
    <div class="lightbox__frame" data-lightbox-frame></div>
    <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close">Close</button>
  </dialog>
</Base>

<style>
  .intro { display: grid; gap: 1.25rem; padding-block: clamp(3rem, 8vw, 5.5rem) 1rem; }

  .rugby { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: start; }
  .rugby__copy { display: grid; gap: 1.2rem; }
  .rugby__strip { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .honors { list-style: none; margin: 0; padding: 0; }
  .honors li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding: 0.65rem 0; border-top: 1px solid var(--line); font-size: 0.9375rem; }

  .gallery { columns: 3 260px; column-gap: 1rem; }
  .gallery__item {
    display: block; width: 100%; margin: 0 0 1rem; padding: 0; border: 0; background: none;
    break-inside: avoid; cursor: zoom-in;
    transition: transform 400ms var(--ease-out);
  }
  .gallery__item:hover { transform: translateY(-4px); }
  .gallery__item :global(.ph), .gallery__item :global(.photo) { transition: box-shadow 400ms var(--ease-out); }
  .gallery__item:hover :global(.ph), .gallery__item:hover :global(.photo) { box-shadow: 0 22px 44px -20px var(--shadow); }

  .hobbies { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 3vw, 2rem); }
  .hobby { display: grid; gap: 0.75rem; align-content: start; }

  .lightbox {
    width: min(92vw, 1100px); max-height: 90vh; padding: 0; border: 0; background: transparent; color: var(--ink);
    overflow: visible;
  }
  .lightbox::backdrop { background: rgb(10 12 11 / 0.9); backdrop-filter: blur(6px); }
  .lightbox[open] .lightbox__frame { animation: pop 260ms var(--ease); }
  .lightbox__frame :global(.ph) { max-height: 82vh; }
  .lightbox__frame :global(img) { display: block; max-width: 100%; max-height: 82vh; margin-inline: auto; border-radius: 12px; }
  .lightbox__close {
    position: absolute; top: -2.75rem; right: 0;
    font: inherit; font-weight: 700; color: var(--ink); background: var(--white); border: 1.5px solid var(--ink); border-radius: 999px;
    padding: 0.35rem 0.9rem; cursor: pointer;
  }
  @keyframes pop { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: none; } }

  @media (max-width: 860px) {
    .rugby, .hobbies { grid-template-columns: 1fr; }
  }
</style>
